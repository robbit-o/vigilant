CHILE_USERNAME=username
CHILE_PASSWORD=password

CHILE_LOGIN_URL=https://chile.example.com/login
CHILE_HOME_URL=https://chile.example.com/home
CHILE_CREDIT_TRANSACTIONS_URL=https://chile.example.com/credit-transactions

FALABELLA_USERNAME=username
FALABELLA_PASSWORD=password

FALABELLA_LOGIN_URL=https://falabella.example.com/login
FALABELLA_HOME_URL=https://falabella.example.com/home

GCLOUD_PROJECT=project-id
BUCKET_NAME=screenshot-bucket

# Name of the Docker volume that holds the gcloud CLI config, mounted at
# /root/.config/gcloud inside the container. It must be the volume created by the
# devcontainer "gcloud-cli-persistence" feature, so the container and the local
# CLI share the same Application Default Credentials.
# Find it with: docker volume ls | grep gcloud-cli
GCLOUD_CREDS_VOLUME=devcontainer-gcloud-cli-volume

STORAGE_LOCATION=local

BROWSER_RECORD_VIDEO=false

# Browser build used by Playwright. "chromium" is the full browser, while the
# default headless mode runs "chromium_headless_shell", which has no plugins
# and no window.chrome object. Targets fingerprint the engine.
BROWSER_CHANNEL=chromium

# Identity reported to the target sites. Keep the timezone aligned with the one
# used when the sheets are written.
BROWSER_LOCALE=es-CL
BROWSER_TIMEZONE=America/Santiago
