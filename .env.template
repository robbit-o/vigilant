CHILE_USERNAME=
CHILE_PASSWORD=

CHILE_LOGIN_URL=
CHILE_HOME_URL=
CHILE_CREDIT_TRANSACTIONS_URL=

FALABELLA_USERNAME=
FALABELLA_PASSWORD=

FALABELLA_LOGIN_URL=
FALABELLA_HOME_URL=

# Screenshot/Video storage mode: local or gcloud
STORAGE_LOCATION=local

# Playwright Browser settings
BROWSER_RECORD_VIDEO=false
BROWSER_CHANNEL=chromium
BROWSER_LOCALE=es-CL
BROWSER_TIMEZONE=America/Santiago

# Infisical (self-hosted) runtime defaults
INFISICAL_ENV=dev
INFISICAL_REDIS_URL=redis://redis:6379

# The INFISICAL_* bootstrap secrets (DB_PASSWORD, ENCRYPTION_KEY, AUTH_SECRET,
# PROJECT_ID, TOKEN) are managed encrypted in secrets.enc.env (SOPS + age).
# They are listed here empty in case you prefer to keep them in a plain .env.
INFISICAL_PROJECT_ID=
INFISICAL_DB_PASSWORD=
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_TOKEN=

# GCloud settings
GCLOUD_PROJECT=project-id
BUCKET_NAME=screenshot-bucket
